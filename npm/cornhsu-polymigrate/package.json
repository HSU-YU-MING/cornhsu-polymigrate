{
  "name": "cornhsu-polymigrate",
  "version": "0.0.0-placeholder",
  "description": "Migrate a legacy multilingual website to a static site: mirror HTML becomes frontmatter Markdown for Hugo, Eleventy or Astro, language versions are paired automatically, 301 redirect maps are generated, and links, media and redirects are verified offline.",
  "keywords": [
    "i18n",
    "internationalization",
    "multilingual",
    "website-migration",
    "site-migration",
    "cms-migration",
    "html-to-markdown",
    "hreflang",
    "redirects",
    "static-site",
    "markdown",
    "web-scraping",
    "content-migration",
    "hugo",
    "eleventy",
    "astro"
  ],
  "homepage": "https://cornhsu.com/polymigrate",
  "bugs": "https://github.com/HSU-YU-MING/cornhsu-polymigrate/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HSU-YU-MING/cornhsu-polymigrate.git"
  },
  "license": "MIT",
  "author": "許彧銘 Hsu Yu-Ming (https://cornhsu.com/)",
  "type": "commonjs",
  "bin": {
    "polymigrate": "bin/polymigrate.js"
  },
  "files": [
    "bin/polymigrate.js",
    "README.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "@cornhsu/polymigrate-win32-x64": "0.0.0-placeholder",
    "@cornhsu/polymigrate-win32-arm64": "0.0.0-placeholder",
    "@cornhsu/polymigrate-linux-x64": "0.0.0-placeholder",
    "@cornhsu/polymigrate-linux-arm64": "0.0.0-placeholder",
    "@cornhsu/polymigrate-darwin-x64": "0.0.0-placeholder",
    "@cornhsu/polymigrate-darwin-arm64": "0.0.0-placeholder"
  }
}
