<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Cornhsu.PolyMigrate.Core</PackageId>
    <Description>Core library of PolyMigrate — the i18n-first static-site migrator. Extraction, bilingual pairing, and inventory components.</Description>
    <IsPackable>true</IsPackable>

    <!-- 把 /// 註解打包進 nupkg,函式庫消費者才有 IntelliSense。
         CS1591(缺 XML 註解)/ CS1573(只註解部分參數)不擋建置:選擇性註解是本 codebase 慣例,
         不該讓 warnings-as-errors 失敗 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PolyMigrate.Core.Tests" />
    <!-- CLI(組件名 polymigrate)也看得到 internal:CLI 需要的細節(例如 probe 有幾個候選沒拿到回答)
         走 internal 成員,不必為了 CLI 擴大函式庫的 public 面(那是 semver 契約,新增成員就是 minor) -->
    <InternalsVisibleTo Include="polymigrate" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.7.2" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.16.0" />
    <PackageReference Include="ReverseMarkdown" Version="6.2.1" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

</Project>
